# Reference only: the plugin does not load .env automatically.
BILI_PLATFORM_URL=https://bilidyn.basmc.org
BILI_PLATFORM_ALLOWED_HOSTS=bilidyn.basmc.org
BILI_PLATFORM_SID=
# Exact AstrBot unified_msg_origin values, comma-separated. Empty disables sharing.
BILI_PLATFORM_SHARED_SESSION_WHITELIST=
BILI_PLATFORM_ALLOW_PASSWORD_LOGIN=0
# Optional: external Fernet key; leave empty to use runtime secret.key.
# BILI_PLATFORM_AUX_SECRET_KEY=
